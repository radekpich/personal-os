# Database connection URL. Use sqlite+aiosqlite for local dev, postgresql+asyncpg for prod.
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Secret key used to sign JWT access tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-secret

# JWT signing algorithm.
ALGORITHM=HS256

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days.
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated list of allowed CORS origins. Never use "*".
CORS_ORIGINS=http://localhost:3000

# Whether cookies are marked Secure (requires HTTPS). Set to true in production.
COOKIE_SECURE=true

# Name of the httpOnly access token cookie.
ACCESS_COOKIE_NAME=access_token

# Name of the httpOnly refresh token cookie.
REFRESH_COOKIE_NAME=refresh_token

# Name of the readable CSRF token cookie (double-submit pattern).
CSRF_COOKIE_NAME=csrf_token

# Name of the request header clients must send with the CSRF token.
CSRF_HEADER_NAME=X-CSRF-Token

# Rate limit applied to POST /auth/login, e.g. "5/minute".
RATE_LIMIT_LOGIN=5/minute

# Default global rate limit applied to all other routes.
RATE_LIMIT_DEFAULT=100/minute

# Deployment environment name, used for logging/config decisions.
ENVIRONMENT=development

# Directory where uploaded attachment files are stored. Keep it outside frontend/public.
ATTACHMENTS_DIR=./data/attachments

# Maximum size of one uploaded attachment in MB.
MAX_ATTACHMENT_SIZE_MB=15

# Maximum total attachment storage budget in MB.
MAX_STORAGE_MB=17000
